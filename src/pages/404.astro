---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHOICES, QUESTION } from '../utils/notFoundQuiz';
---

<BaseLayout title="Not Found">
	<div class="home">
		<h1>Not Found</h1>

		<p>{QUESTION}</p>
		<ol class="choices">
			{
				CHOICES.map((choice) => (
					<li>
						<a href={`/404/${choice.id}/`}>{choice.text}</a>
					</li>
				))
			}
		</ol>
	</div>
</BaseLayout>

<style>
	@counter-style choices-katakana {
		system: fixed;
		symbols: ア イ ウ エ;
		suffix: '　';
	}

	.choices {
		list-style-type: choices-katakana;
	}

	.choices li {
		margin-top: 0.5em;
	}
</style>
